# Canonical production application URL. Preview deployments continue to use
# VERCEL_URL automatically, and local development falls back to localhost:3000.
NEXT_PUBLIC_APP_URL=https://vaivia.app

# Dedicated VAIVIA travel assistant and Phase 2B Search grounding (server-side only)
GEMINI_ASSISTANT_API_KEY=
# Routine chat and safe tool selection; defaults to gemini-3.1-flash-lite.
GEMINI_ASSISTANT_FAST_MODEL=gemini-3.1-flash-lite
# Complex multi-day planning/synthesis; defaults to gemini-3.5-flash.
GEMINI_ASSISTANT_STRONG_MODEL=gemini-3.5-flash
# Legacy strong-model fallback. Prefer the two tier-specific variables above.
GEMINI_ASSISTANT_MODEL=
AI_DAILY_MESSAGE_LIMIT=

# Phase 2A live place discovery (server-side Google Places API (New) key only)
GOOGLE_PLACES_API_KEY=

# Phase 1 trip-overview weather widget (server-side Google Weather API key only)
GOOGLE_WEATHER_API_KEY=

# Phase 2 scheduled adverse-weather monitoring (server-only; do not expose)
GOOGLE_WEATHER_MONITOR_API_KEY=
WEATHER_CRON_SECRET=

# Optional comma-separated Chrome extension IDs. Set in production once the
# Chrome Web Store ID is known to restrict account connection callbacks.
VAIVIA_BROWSER_EXTENSION_IDS=

# Resend inbound travel-confirmation forwarding (server-side only)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=VAIVIA <notifications@updates.vaivia.app>
RESEND_REPLY_TO_EMAIL=
EMAIL_IMPORT_DOMAIN=inbound.vaivia.app
# Airport geocoding and time-zone lookup for import review (server-side only)
GOOGLE_MAPS_SERVER_API_KEY=

# VAIVIA Events payments (server-side standard Stripe account; never use Connect)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protected Vercel Cron bearer used by scheduled maintenance
CRON_SECRET=
# Optional Events-only override; falls back to CRON_SECRET
EVENTS_MAINTENANCE_SECRET=

# Web Push (standards-based VAPID). Generate once and keep this pair stable.
# Legacy NEXT_PUBLIC_VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT values
# remain accepted during deployment migration, but new deployments should use:
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@vaivia.app

# Apple Wallet event-ticket signing (server-side only)
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE_BASE64=
APPLE_WALLET_PRIVATE_KEY_BASE64=
APPLE_WALLET_PRIVATE_KEY_PASSWORD=
APPLE_WALLET_WWDR_CERTIFICATE_BASE64=

# Google Wallet Event Ticket pass signing (server-side only)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
